{
  "name": "spindle",
  "version": "0.0.1",
  "description": "",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "bin": {
    "spindle": "./build/index.js"
  },
  "files": [
    "build",
    "assets"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf build/blueprints && tsc && tsc-alias && mkdir -p build/blueprints build/setup-project/templates && cp -R src/blueprints/. build/blueprints/ && cp -R src/setup-project/templates/. build/setup-project/templates/ && chmod 755 build/index.js",
    "start": "node build/index.js",
    "spindle": "tsx src/index.ts",
    "init": "tsx src/index.ts init",
    "update": "tsx src/index.ts update",
    "validate": "tsx src/index.ts validate",
    "publish": "tsx src/index.ts publish",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.91.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.11.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.11.1"
}

  "repository": {
    "type": "git",
    "url": "git+https://github.com/UseTheFork/spindle.git"
  },
  "bin": {
    "spindle": "./build/index.js"
  },
  "files": [
    "build",
    "assets"
  ],
  "type": "module",
  "scripts": {
    "build": "rm -rf build && tsc && tsc-alias && cp -R src/Assets/Blueprints/agents src/Assets/Blueprints/instructions src/Assets/Blueprints/skills build/Assets/Blueprints/ && cp -R src/Assets/Templates build/Assets/ && chmod 755 build/index.js",
    "spindle": "tsx src/index.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "chalk": "^6.0.1",
    "commander": "^15.0.0",
    "gray-matter": "^4.0.3",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@types/cors": "^2.8.19",
    "@types/node": "^26.6.6",
    "@types/nunjucks": "^3.2.6",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.91.0",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "onFail": "warn"
    }
  }
}
